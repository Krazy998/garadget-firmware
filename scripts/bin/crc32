#!/usr/bin/env python3
import sys
import zlib

if len(sys.argv) < 2:
    data = sys.stdin.buffer.read()
    print(f"{zlib.crc32(data) & 0xFFFFFFFF:08x}")
else:
    for path in sys.argv[1:]:
        with open(path, "rb") as f:
            crc = zlib.crc32(f.read()) & 0xFFFFFFFF
        if len(sys.argv) == 2:
            print(f"{crc:08x}")
        else:
            print(f"{crc:08x}\t{path}")
